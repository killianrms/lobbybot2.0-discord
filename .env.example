# Discord Bot Token
DISCORD_TOKEN=your_discord_token_here

# Base SQLite PARTAGÉE avec le dashboard (lobbybot2.0-website).
# Pointe vers le même fichier .db pour que les deux projets partagent les bots.
# Windows : C:\Users\<toi>\Desktop\dev\bot\lobbybot2.0-website\data\lobbybot.db
DB_PATH=../lobbybot2.0-website/data/lobbybot.db

# Dashboard URL (optional)
DASHBOARD_URL=http://localhost:3000

# Admin Configuration
# Discord User IDs allowed to use /admin commands (comma-separated)
ADMIN_IDS=335755692134891520

# Manager Secret for Socket.io authentication (generate a strong random string)
MANAGER_SECRET=changeme_with_a_strong_random_secret_32chars_minimum

# LobbyBot Premium
PREMIUM_BOT_QUOTA=3
PREMIUM_ROLE_ID=
PREMIUM_SKU_ID=

# Lobby exclusif : dès qu'un joueur est dans le groupe d'un bot, la party passe
# en privé et le bot refuse les autres invitations ; il redevient dispo quand il
# est seul. Mettre "false" pour revenir aux lobbies partagés.
EXCLUSIVE_LOBBY=true

# Pseudos Epic autorisés à utiliser les commandes admin in-game (!kick, !promote…)
# LOBBY_ADMIN_PSEUDOS=AerozOff

# Générateur de comptes (fn_account_generator)
# Watchdog d'inactivité : aucune limite de durée totale (le générateur est volontairement
# lent pour rester "humain"). Il n'est tué que s'il n'écrit plus RIEN pendant ce délai
# (navigateur/captcha gelé). Défaut 900000 (15 min de silence).
GENERATOR_STALL_TIMEOUT_MS=900000
